# Home Assistant MCP bridge for Pi.
# Fill these in, then restart pi or run /reload.

# Option A: run ha-mcp locally over stdio (default uses /home/nico/.local/bin/uvx; Docker fallback if uvx is unavailable)
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=replace_with_home_assistant_long_lived_access_token
# HA_VERIFY_SSL=false

# Option B: connect to an already-running ha-mcp HTTP/SSE endpoint instead of Docker.
# If set, HOMEASSISTANT_URL/TOKEN above are not used by this Pi extension.
HA_MCP_URL=http://homeassistant.coati-newton.ts.net:9583/private_YgBWfVWM2SvX3sMUXPDiDQ
# HA_MCP_TOKEN=
# HA_MCP_AUTHORIZATION=Bearer your-token

# Keep ha-mcp from exposing its full ~84-tool catalog to Pi.
ENABLE_TOOL_SEARCH=true
TOOL_SEARCH_MAX_RESULTS=5

# Optional stdio command override. HA_MCP_ARGS must be a JSON array if set.
# HA_MCP_COMMAND=/home/nico/.local/bin/uvx
# HA_MCP_ARGS=["--python","3.13","ha-mcp"]

# Optional Docker fallback override.
HA_MCP_DOCKER_IMAGE=ghcr.io/homeassistant-ai/ha-mcp:latest
