#!/bin/bash

# Fully black screensaver, for OLED panels.
#
# Drop-in replacement for omarchy-launch-screensaver: same window class, so the
# stock Hyprland fullscreen rules for org.omarchy.screensaver still apply, and
# omarchy-system-lock still kills it on lock. The only difference is that it
# runs black-screensaver-window instead of the tte animation, so the screen
# stays completely black.

PATH="$HOME/.local/share/omarchy/bin:$PATH"

# Exit early if the screensaver is already running
pgrep -f org.omarchy.screensaver >/dev/null && exit 0

# Honour `omarchy toggle screensaver`, but allow a forced start
if omarchy-toggle-enabled screensaver-off && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q 2>/dev/null

focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id)
runner="$HOME/.local/bin/black-screensaver-window"

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hyprctl dispatch focusmonitor "$m"

  case $terminal in
  *Alacritty*)
    hyprctl dispatch exec -- \
      alacritty --class=org.omarchy.screensaver \
      --config-file "$OMARCHY_PATH/default/alacritty/screensaver.toml" \
      -e "$runner"
    ;;
  *ghostty*)
    hyprctl dispatch exec -- \
      ghostty --class=org.omarchy.screensaver \
      --config-file="$OMARCHY_PATH/default/ghostty/screensaver" \
      -e "$runner"
    ;;
  *foot*)
    hyprctl dispatch exec -- \
      foot --app-id=org.omarchy.screensaver \
      --config="$OMARCHY_PATH/default/foot/screensaver.ini" \
      -e "$runner"
    ;;
  *kitty*)
    hyprctl dispatch exec -- \
      kitty --class=org.omarchy.screensaver \
      --override background=#000000 \
      --override window_padding_width=0 \
      -e "$runner"
    ;;
  *)
    notify-send -u low "✋  Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
    ;;
  esac
done

hyprctl dispatch focusmonitor "$focused"
