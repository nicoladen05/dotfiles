#!/usr/bin/env bash

VPN_PROFILE="sonia4"
SERVICE="openvpn-client@${VPN_PROFILE}"

if systemctl is-active --quiet "$SERVICE"; then
    if sudo systemctl stop "$SERVICE"; then
        notify-send -u low "  VPN" "Disconnected from $VPN_PROFILE"
    else
        notify-send -u critical "  VPN" "Failed to disconnect from $VPN_PROFILE"
    fi
else
    if sudo systemctl start "$SERVICE"; then
        notify-send -u low "  VPN" "Connected to $VPN_PROFILE"
    else
        notify-send -u critical "  VPN" "Failed to connect to $VPN_PROFILE"
    fi
fi
